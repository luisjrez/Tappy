TAPPY_ENVIRONMENT=local
TAPPY_SECRET_KEY=replace-with-a-random-value-of-at-least-32-characters
TAPPY_HOST=127.0.0.1
TAPPY_PORT=8000
TAPPY_ACCESS_TOKEN_TTL_SECONDS=900
TAPPY_SESSION_MAX_LIFETIME_SECONDS=2592000
TAPPY_ADMIN_SECURE_COOKIES=false
TAPPY_POSTGRES_PASSWORD=replace-with-a-local-password
TAPPY_POSTGRES_PORT=5482
TAPPY_DATABASE_URL=postgresql+psycopg://tappy:replace-with-a-local-password@127.0.0.1:5482/tappy
TAPPY_TEST_POSTGRES_PASSWORD=replace-with-a-test-password
TAPPY_TEST_POSTGRES_PORT=5483
TAPPY_TEST_DATABASE_URL=postgresql+psycopg://tappy_test:replace-with-a-test-password@127.0.0.1:5483/postgres
TAPPY_PUBLIC_BASE_URL=http://127.0.0.1:8000
TAPPY_PASSWORD_RESET_TTL_SECONDS=1800
TAPPY_SMTP_HOST=127.0.0.1
TAPPY_SMTP_PORT=1025
TAPPY_SMTP_STARTTLS=false
TAPPY_MAIL_FROM=Tappy <no-reply@tappy.example>
