            {
              "type": "text",
              "id": "Ait1c",
              "name": "Illustration Notes",
              "fill": "$text-secondary",
              "textGrowth": "fixed-width",
              "width": 1600,
              "content": "Estilo: un solo objeto grande y centrado, contorno ill-ink grueso, caras en ill-mint / ill-paper, lateral en ill-emerald, acento ill-sun y puntitos amarillos y menta alrededor. Lista y aplicada: Sin notificaciones. Pago recibido salió con forma de servidores (rehacer). Solicitud vencida, Día sin cobros, Sin conexión y Pago rechazado esperan créditos de generación; mientras tanto las pantallas conservan su ilustración anterior.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
